            for (Candidate.Project proj : candidate.projects()) {
                if (proj.description() != null) corpus.append(proj.description()).append(" ");
                if (proj.tags() != null) corpus.append(String.join(" ", proj.tags())).append(" ");
            }
        }

        return corpus.toString();
    }


